# Market Sano — configuración local
# Copia este archivo a .env y ajusta según tu instalación.
# Nunca hagas commit de .env (está en .gitignore).

# ── Base de datos ──────────────────────────────────────────────
# SQLite (por defecto, perfil minimal) — el volumen ./data persiste:
DATABASE_URL=sqlite:////data/app.db
# PostgreSQL (perfil standard):
# DATABASE_URL=postgresql://marketsano:marketsano@db:5432/marketsano
# POSTGRES_PASSWORD=marketsano

# ── Autenticación ──────────────────────────────────────────────
# none  → sin login: hogar por defecto, owner implícito (cero fricción)
# local → registro con email + contraseña (multi-usuario, roles, invitaciones)
AUTH_MODE=none

# ── IA (opcional; el sistema es 100% funcional sin IA) ─────────
# Valores: none | openrouter | anthropic | gemini | deepseek | openai_compatible
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── MCP ────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio   # stdio | http
MCP_HTTP_PORT=8765

# ── Home Assistant (opcional) ──────────────────────────────────
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://mqtt:1883

# ── Conector de supermercados (opcional, 100% local) ──────────
# Requiere Node.js; consulta docs/connectors/README.md
SUPERMERCADOS_ENABLED=false

# ── Capa de precios ────────────────────────────────────────────
# Horas de vida útil de un precio en caché antes de requerir refresco
PRICE_CACHE_TTL_HOURS=12
